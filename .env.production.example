PUBLIC_ORIGIN=https://exam.example.edu
CORS_ALLOWED_ORIGINS=https://exam.example.edu
MONGODB_URI=mongodb+srv://PORTAL_USER:URL_ENCODED_PASSWORD@cluster.example/bsbe_portal?retryWrites=true&w=majority
LOG_LEVEL=log
INSTITUTE_EMAIL_DOMAIN=iitb.ac.in

SMTP_HOST=smtp.example.edu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=BSBE Portal <no-reply@example.edu>
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-in-secret-store
MAILPIT_UI_URL=https://mail.invalid
OBJECT_STORAGE_PROVIDER=s3-compatible

OTP_PEPPER=replace-with-at-least-32-random-characters
SESSION_TOKEN_PEPPER=replace-with-a-different-32-character-secret
CSRF_SECRET=replace-with-a-different-32-character-secret
IP_HASH_KEY=replace-with-a-different-32-character-secret
QUESTION_RUBRIC_KEYS_JSON={"production-v1":"replace-with-base64-encoded-32-byte-key"}
QUESTION_RUBRIC_ACTIVE_KEY_VERSION=production-v1

SESSION_COOKIE_NAME=bsbe_session
SESSION_IDLE_TTL_SECONDS=86400
SESSION_ABSOLUTE_TTL_SECONDS=604800
STUDENT_CONCURRENT_LOGIN_POLICY=replace
RECENT_AUTH_MAX_AGE_SECONDS=86400

MEDIA_STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.example.edu
S3_REGION=auto
S3_BUCKET=bsbe-portal-media
S3_ACCESS_KEY_ID=replace-in-secret-store
S3_SECRET_ACCESS_KEY=replace-in-secret-store
S3_FORCE_PATH_STYLE=true

PORTAL_API_IMAGE=registry.example.edu/bsbe/api@sha256:replace
PORTAL_WEB_IMAGE=registry.example.edu/bsbe/web@sha256:replace
NGINX_IMAGE=nginx@sha256:replace
TLS_CERTIFICATE_PATH=C:/secure/certs/fullchain.pem
TLS_PRIVATE_KEY_PATH=C:/secure/certs/privkey.pem
